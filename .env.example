# ============================================================
# منصة سوديا - مثال على متغيرات البيئة
# انسخ هذا الملف إلى .env وعدّل القيم حسب بيئتك
# ============================================================

# قاعدة البيانات - SQLite للتطوير المحلي السريع (لا يحتاج سيرفر خارجي)
DATABASE_URL="file:./dev.db"

# للإنتاج على PostgreSQL استبدل السطر أعلاه بـ:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/soudia_db?schema=public"

# ============================================================
# إعدادات الخادم
# ============================================================
PORT=4000

# ============================================================
# مفتاح JWT (غيّره بقيمة عشوائية قوية في الإنتاج)
# ============================================================
JWT_SECRET=your-strong-jwt-secret-here

# ============================================================
# إعدادات البريد الإلكتروني الرسمي (SMTP)
# ============================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@yourdomain.sa
SMTP_PASS=your-smtp-password-here
OFFICIAL_RECEIVER_EMAIL=admin@yourdomain.sa
